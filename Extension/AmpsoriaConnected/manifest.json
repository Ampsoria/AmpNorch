{
  "manifest_version": 3,
  "name": "Ampsoria Connected",
  "version": "1.2.0",
  "description": "Connects YouTube, YouTube Music, web video, and media playback to AmpNotch on macOS. Developed by Ampsoria.",
  "author": "Ampsoria",
  "homepage_url": "https://github.com/Ampsoria",
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "minimum_chrome_version": "120",
  "background": {
    "service_worker": "background.js"
  }
}
